/**
 * Configuració Cloudflare Workers per Carrers Engalanats
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * La web és de només lectura: els resultats estan fixats al codi
 * (src/data/resultats.ts) i el Worker no té accés a cap base de dades.
 * La base de dades D1 "votacio-db" (09f024c1-d24d-4290-97b6-a595336f6b34)
 * ja no està vinculada, però no s'ha esborrat.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "carrers-engalanats",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-27",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS"
	}
}
